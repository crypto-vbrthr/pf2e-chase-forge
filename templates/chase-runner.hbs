<div class="chase-runner-shell">
  <header class="chase-runner-toolbar">
    <div>
      <h2><i class="fa-solid fa-person-running"></i> {{title}}</h2>
      <div class="chase-runner-meta">
        <span class="chase-runner-pill">{{statusLabel}}</span>
        <span>{{localize "PF2E_CHASE_FORGE.Runner.Round"}} {{session.round}}</span>
        {{#if timeOfDay}}<span><i class="fa-regular fa-clock"></i> {{timeOfDay}}</span>{{/if}}
        {{#if weather}}<span><i class="fa-solid fa-cloud-sun"></i> {{weather}}</span>{{/if}}
      </div>
    </div>
    <div class="chase-runner-toolbar-actions">
      {{#if canBeginRound}}<button type="button" data-action="beginRound"><i class="fa-solid fa-play"></i> {{localize "PF2E_CHASE_FORGE.Runner.BeginRound"}}</button>{{/if}}
      {{#if canEndRound}}<button type="button" data-action="endRound"><i class="fa-solid fa-forward-step"></i> {{localize "PF2E_CHASE_FORGE.Runner.EndRound"}}</button>{{/if}}
      {{#if canPause}}<button type="button" data-action="pauseSession"><i class="fa-solid fa-pause"></i> {{localize "PF2E_CHASE_FORGE.Runner.Pause"}}</button>{{/if}}
      {{#if canResume}}<button type="button" data-action="resumeSession"><i class="fa-solid fa-play"></i> {{localize "PF2E_CHASE_FORGE.Runner.Resume"}}</button>{{/if}}
      <button type="button" data-action="syncPlayers" title="{{localize 'PF2E_CHASE_FORGE.Runner.SyncPlayers'}}"><i class="fa-solid fa-users-viewfinder"></i> {{localize "PF2E_CHASE_FORGE.Runner.SyncPlayers"}}</button>
      <button type="button" data-action="refreshRunner"><i class="fa-solid fa-rotate"></i></button>
      {{#unless terminal}}<button type="button" class="danger" data-action="abortSession"><i class="fa-solid fa-stop"></i> {{localize "PF2E_CHASE_FORGE.Runner.Abort"}}</button>{{/unless}}
    </div>
  </header>

  <div class="chase-runner-layout">
    <aside class="chase-runner-route-monitor">
      <div class="chase-runner-route-monitor-head">
        <h3><i class="fa-solid fa-map"></i> {{localize "PF2E_CHASE_FORGE.Runner.RouteOverview"}}</h3>
        <span class="chase-runner-pill">{{routeMonitor.groupCount}} {{localize "PF2E_CHASE_FORGE.Runner.RuntimeGroups"}}</span>
      </div>
      {{#if usesGroupOrder}}
        <div class="chase-runner-order-controls">
          <span>{{localize "PF2E_CHASE_FORGE.Runner.GroupOrder"}}</span>
          <button type="button" data-action="setGroupOrderAutomatic" class="{{#if groupOrderAutomatic}}active{{/if}}"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "PF2E_CHASE_FORGE.Runner.GroupOrderAutomatic"}}</button>
          <button type="button" data-action="setGroupOrderManual" class="{{#if groupOrderManual}}active{{/if}}"><i class="fa-solid fa-hand-pointer"></i> {{localize "PF2E_CHASE_FORGE.Runner.GroupOrderManual"}}</button>
        </div>
      {{/if}}
      <div class="chase-runner-route-monitor-scroll">
        {{#each routeMonitor.rows as |row|}}
          <div class="chase-runner-route-monitor-row {{#if row.branched}}branched{{/if}}">
            {{#each row.nodes as |node|}}
              <div class="chase-runner-route-monitor-node {{node.type}} {{#if node.hasGroups}}occupied{{/if}}">
                <span class="chase-runner-route-monitor-node-label">{{node.label}}</span>
                {{#if node.markers.length}}
                  <div class="chase-runner-route-monitor-markers">
                    {{#each node.markers as |marker|}}
                      {{#if marker.canActivate}}
                        <button type="button" class="chase-runner-route-marker {{marker.role}} {{#if marker.active}}active{{/if}} {{#if marker.recommended}}recommended{{/if}}" data-action="activateGroup" data-runtime-group-id="{{marker.runtimeGroupId}}" title="{{marker.name}}">
                          {{#if marker.recommended}}<i class="fa-solid fa-star"></i>{{else}}<i class="fa-solid fa-location-dot"></i>{{/if}}
                          <span>{{marker.name}}</span>
                          {{#if marker.remaining}}<small>{{marker.remaining}} {{localize "PF2E_CHASE_FORGE.Runner.FieldsToGoalShort"}}</small>{{/if}}
                        </button>
                      {{else}}
                        <div class="chase-runner-route-marker static {{marker.role}} {{#if marker.active}}active{{/if}} {{#if marker.recommended}}recommended{{/if}}" title="{{marker.name}}">
                          {{#if marker.recommended}}<i class="fa-solid fa-star"></i>{{else}}<i class="fa-solid fa-location-dot"></i>{{/if}}
                          <span>{{marker.name}}</span>
                          {{#if marker.remaining}}<small>{{marker.remaining}} {{localize "PF2E_CHASE_FORGE.Runner.FieldsToGoalShort"}}</small>{{/if}}
                        </div>
                      {{/if}}
                    {{/each}}
                  </div>
                {{/if}}
              </div>
            {{/each}}
          </div>
        {{/each}}
      </div>
      {{#if routeMonitor.distances.length}}
        <div class="chase-runner-route-distances">
          <strong>{{routeMonitor.selectedGroupName}}</strong>
          {{#each routeMonitor.distances as |item|}}<span>↔ {{item.name}}: {{item.distance}} {{localize "PF2E_CHASE_FORGE.Runner.FieldsShort"}}</span>{{/each}}
        </div>
      {{/if}}
    </aside>

    <div class="chase-runner-scroll">
    {{#if completion}}
      <section class="chase-runner-completion">
        {{#if completion.image.path}}
          <button type="button" class="chase-image-popout-button chase-runner-ending-image" data-action="openImage" data-image-src="{{completion.image.path}}" data-image-title="{{completion.image.alt}}" title="{{localize 'PF2E_CHASE_FORGE.Images.OpenFull'}}">
            <img src="{{completion.image.path}}" alt="{{completion.image.alt}}">
            <span class="chase-image-popout-hint"><i class="fa-solid fa-magnifying-glass-plus"></i></span>
          </button>
        {{/if}}
        <div>
          <h3><i class="fa-solid fa-flag-checkered"></i> {{localize "PF2E_CHASE_FORGE.Runner.ChaseFinished"}}</h3>
          <strong>{{completion.outcomeLabel}}</strong>
          {{#if completion.endingLabel}}<p>{{completion.endingLabel}}</p>{{/if}}
          {{#if completion.endingDescription}}<p>{{completion.endingDescription}}</p>{{/if}}
          {{#if completion.winnerNames.length}}<p><b>{{localize "PF2E_CHASE_FORGE.Runner.Winners"}}:</b> {{#each completion.winnerNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
        </div>
      </section>
    {{else if chaseImage.path}}
      <button type="button" class="chase-image-popout-button chase-runner-chase-image" data-action="openImage" data-image-src="{{chaseImage.path}}" data-image-title="{{chaseImage.alt}}" title="{{localize 'PF2E_CHASE_FORGE.Images.OpenFull'}}">
        <img src="{{chaseImage.path}}" alt="{{chaseImage.alt}}">
        <span class="chase-image-popout-hint"><i class="fa-solid fa-magnifying-glass-plus"></i></span>
      </button>
    {{/if}}

    {{#if hasConsequences}}
      <section class="chase-runner-consequences">
        <h3><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PF2E_CHASE_FORGE.Runner.OpenConsequences"}}</h3>
        {{#each consequenceRecords as |record|}}
          <article class="chase-runner-consequence {{record.status}}">
            <div class="grow">
              <strong>{{record.consequenceLabel}}</strong>
              <span class="chase-runner-pill">{{record.statusLabel}}</span>
              {{#if record.message}}<p>{{record.message}}</p>{{/if}}
            </div>
            {{#if record.canConfirm}}
              <button type="button" data-action="confirmConsequence" data-occurrence-id="{{record.occurrenceId}}"><i class="fa-solid fa-check"></i> {{localize "PF2E_CHASE_FORGE.Runner.Apply"}}</button>
            {{/if}}
            {{#if record.needsRouteSelection}}
              <div class="chase-runner-route-buttons">
                {{#each record.routeChoices as |route|}}
                  <button type="button" data-action="selectConsequenceRoute" data-occurrence-id="{{record.occurrenceId}}" data-edge-id="{{route.edgeId}}">{{route.label}}</button>
                {{/each}}
              </div>
            {{/if}}
          </article>
        {{/each}}
      </section>
    {{/if}}

    {{#if race}}
      <section class="chase-runner-initiative">
        <h3><i class="fa-solid fa-list-ol"></i> {{localize "PF2E_CHASE_FORGE.Runner.RaceInitiative"}}</h3>
        {{#if canBeginRound}}
          {{#if raceInitiativeRequired}}
            <p>{{localize "PF2E_CHASE_FORGE.Runner.RaceInitiativeHint"}}</p>
            <div class="chase-runner-initiative-grid">
              {{#each initiativeEntries as |entry|}}
                <label class="chase-runner-initiative-row" data-race-initiative-row data-participant-id="{{entry.participantId}}">
                  <span><strong>{{entry.participantName}}</strong><small>{{entry.groupName}}</small></span>
                  <input type="number" data-race-initiative-value step="1" placeholder="{{localize 'PF2E_CHASE_FORGE.Runner.Initiative'}}">
                </label>
              {{/each}}
            </div>
          {{else}}
            <p>{{localize "PF2E_CHASE_FORGE.Runner.RaceSteadyOnly"}}</p>
          {{/if}}
        {{else if initiativeOrderDisplay.length}}
          <div class="chase-runner-initiative-order">
            {{#each initiativeOrderDisplay as |entry|}}
              <span class="chase-runner-initiative-chip {{#if entry.current}}current{{/if}} {{#if entry.acted}}acted{{/if}}"><b>{{entry.order}}.</b> {{entry.participantName}}{{#if entry.groupName}} <small>· {{entry.groupName}}</small>{{/if}}</span>
            {{/each}}
          </div>
        {{/if}}
      </section>
    {{/if}}

    <div class="chase-runner-groups">
      {{#each groups as |group|}}
        <section class="chase-runner-group {{#if group.isActiveGroup}}active-runtime-group{{/if}} {{#if group.isRecommendedGroup}}recommended-runtime-group{{/if}}">
          <header class="chase-runner-group-head">
            <div>
              <h3>{{group.displayName}}</h3>
              <div class="chase-runner-meta"><span>{{group.roleLabel}}</span><span>{{group.paceLabel}}</span><span>{{group.statusLabel}}</span>{{#if group.obstacleIndex}}<span>{{localize "PF2E_CHASE_FORGE.Runner.Position"}} {{group.obstacleIndex}}</span>{{/if}}</div>
            </div>
            <div class="chase-runner-group-head-actions">
              {{#if group.isRecommendedGroup}}<span class="chase-runner-pill recommended"><i class="fa-solid fa-star"></i> {{localize "PF2E_CHASE_FORGE.Runner.RecommendedNext"}}{{#if group.distanceToEnd}} · {{group.distanceToEnd}} {{localize "PF2E_CHASE_FORGE.Runner.FieldsToGoalShort"}}{{/if}}</span>{{/if}}
              {{#if group.canActivateGroup}}<button type="button" data-action="activateGroup" data-runtime-group-id="{{group.runtime.id}}"><i class="fa-solid fa-hand-pointer"></i> {{localize "PF2E_CHASE_FORGE.Runner.ActivateGroup"}}</button>{{/if}}
              {{#if group.turnBlocked}}<span class="chase-runner-pill turn-wait"><i class="fa-solid fa-hourglass-half"></i> {{#if group.waitingForInitiative}}{{localize "PF2E_CHASE_FORGE.Runner.WaitingForInitiative"}}{{else if group.waitingForGroupOrder}}{{localize "PF2E_CHASE_FORGE.Runner.WaitingForGroupOrder"}}{{else}}{{localize "PF2E_CHASE_FORGE.Runner.WaitingForQuarry"}}{{/if}}</span>{{/if}}
              {{#if group.obstacle}}
                <button type="button" data-action="postObstacle" data-runtime-group-id="{{group.runtime.id}}"><i class="fa-solid fa-message"></i> {{localize "PF2E_CHASE_FORGE.Runner.PostChat"}}</button>
              {{/if}}
            </div>
          </header>

          {{#if group.canManageGroup}}
            <details class="chase-runner-group-manager">
              <summary><i class="fa-solid fa-people-arrows-left-right"></i> {{localize "PF2E_CHASE_FORGE.Runner.ManageGroup"}}</summary>
              <p>{{localize "PF2E_CHASE_FORGE.Runner.SplitGroupHint"}}</p>
              <div class="chase-runner-split-participants">
                {{#each group.splitParticipants as |participant|}}
                  <label><input type="checkbox" value="{{participant.id}}" data-split-participant> <span>{{participant.name}}{{#if participant.acted}} ✓{{/if}}</span></label>
                {{/each}}
              </div>
              <div class="chase-runner-group-manager-actions">
                {{#if group.splitAllowed}}<button type="button" data-action="splitGroup" data-runtime-group-id="{{group.runtime.id}}"><i class="fa-solid fa-code-branch"></i> {{localize "PF2E_CHASE_FORGE.Runner.SplitSelected"}}</button>{{/if}}
                {{#if group.hasTransferCandidates}}
                  {{#each group.transferCandidates as |other|}}
                    <button type="button" data-action="transferParticipants" data-runtime-group-id="{{../runtime.id}}" data-other-runtime-group-id="{{other.runtimeGroupId}}"><i class="fa-solid fa-right-left"></i> {{localize "PF2E_CHASE_FORGE.Runner.MoveSelectedTo"}} {{other.name}}</button>
                  {{/each}}
                {{/if}}
              </div>
            </details>
          {{/if}}
          {{#if group.hasMergeCandidates}}
            <div class="chase-runner-merge-offers">
              <strong><i class="fa-solid fa-people-group"></i> {{localize "PF2E_CHASE_FORGE.Runner.MergeGroups"}}</strong>
              {{#each group.mergeCandidates as |other|}}
                <button type="button" data-action="mergeGroups" data-runtime-group-id="{{../runtime.id}}" data-other-runtime-group-id="{{other.runtimeGroupId}}"><i class="fa-solid fa-link"></i> {{other.name}}</button>
              {{/each}}
            </div>
          {{/if}}

          {{#if group.obstacle}}
            <div class="chase-runner-obstacle">
              {{#if group.obstacle.card.image.path}}
                <button type="button" class="chase-image-popout-button chase-runner-image-button" data-action="openImage" data-image-src="{{group.obstacle.card.image.path}}" data-image-title="{{group.obstacle.card.image.alt}}" title="{{localize 'PF2E_CHASE_FORGE.Images.OpenFull'}}">
                  <img class="chase-runner-obstacle-image" src="{{group.obstacle.card.image.path}}" alt="{{group.obstacle.card.image.alt}}">
                  <span class="chase-image-popout-hint"><i class="fa-solid fa-magnifying-glass-plus"></i></span>
                </button>
              {{/if}}
              <div class="chase-runner-obstacle-body">
                <h4>{{group.obstacle.card.name}}</h4>
                {{#if group.obstacle.card.description}}<p>{{group.obstacle.card.description}}</p>{{/if}}
                <div class="chase-runner-progress-line">
                  <strong>{{group.obstacle.progress}} / {{group.obstacle.requiredPoints}} {{localize "PF2E_CHASE_FORGE.Runner.ChasePoints"}}</strong>
                  <progress max="{{group.obstacle.requiredPoints}}" value="{{group.obstacle.progress}}"></progress>
                </div>
                {{#if group.obstacle.card.gmNotes}}<details><summary>{{localize "PF2E_CHASE_FORGE.Runner.GmNotes"}}</summary><p>{{group.obstacle.card.gmNotes}}</p></details>{{/if}}
              </div>
            </div>

            {{#if group.approaches.length}}
              <div class="chase-runner-approaches">
                <h4>{{localize "PF2E_CHASE_FORGE.Runner.Approaches"}}</h4>
                {{#each group.approaches as |approach|}}
                  <div class="chase-runner-approach"><strong>{{approach.label}}</strong><span>{{approach.statistic}}</span>{{#if approach.needsGmDc}}<label class="chase-runner-gm-dc"><span>{{localize "PF2E_CHASE_FORGE.Runner.DC"}}</span><input type="number" data-gm-dc data-approach-id="{{approach.id}}" min="0" max="99" value="{{approach.storedGmDc}}" placeholder="{{localize 'PF2E_CHASE_FORGE.Runner.DC'}}"></label>{{else}}<span>{{localize "PF2E_CHASE_FORGE.Runner.DC"}} {{approach.dcResolved}}</span>{{/if}}{{#if approach.description}}<span class="grow">{{approach.description}}</span>{{/if}}</div>
                {{/each}}
              </div>
            {{/if}}

            <div class="chase-runner-participants">
              {{#each group.participants as |participant|}}
                <article class="chase-runner-participant" data-runner-participant>
                  <div class="chase-runner-participant-name">
                    {{#if participant.image}}<img src="{{participant.image}}" alt="">{{/if}}
                    <div>
                      <strong>{{participant.name}}</strong>
                      {{#if participant.acted}}
                        <small>{{localize "PF2E_CHASE_FORGE.Runner.Acted"}}{{#if participant.skipped}} · {{localize "PF2E_CHASE_FORGE.Runner.Skipped"}}{{/if}}</small>
                        {{#if participant.lastResult}}<small class="chase-runner-participant-result {{participant.lastResult.type}}"><i class="fa-solid fa-circle-check"></i> {{participant.lastResult.label}}</small>{{/if}}
                      {{else}}
                        <small>{{localize "PF2E_CHASE_FORGE.Runner.NotActed"}}</small>
                      {{/if}}
                    </div>
                  </div>
                  {{#if participant.canAct}}
                    <div class="chase-runner-participant-actions">
                      {{#each participant.approaches as |approach|}}
                        {{#if approach.statistic}}
                          <button type="button" data-action="rollApproach" data-runtime-group-id="{{group.runtime.id}}" data-participant-id="{{participant.id}}" data-approach-id="{{approach.id}}"><i class="fa-solid fa-dice-d20"></i> {{approach.label}}{{#if approach.modifierLabel}} <span class="chase-skill-modifier">{{approach.modifierLabel}}</span>{{/if}}</button>
                        {{/if}}
                      {{/each}}
                      {{#if group.approaches.length}}
                        <div class="chase-runner-manual">
                          <select data-runner-field="manualApproach">{{#each participant.manualApproaches as |option|}}<option value="{{option.value}}">{{option.label}}</option>{{/each}}</select>
                          <select data-runner-field="manualDegree">{{#each participant.degreeOptions as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select>
                          <button type="button" data-action="applyManualDegree" data-runtime-group-id="{{group.runtime.id}}" data-participant-id="{{participant.id}}">{{localize "PF2E_CHASE_FORGE.Runner.Manual"}}</button>
                        </div>
                      {{/if}}
                      <button type="button" data-action="automaticContribution" data-runtime-group-id="{{group.runtime.id}}" data-participant-id="{{participant.id}}">{{localize "PF2E_CHASE_FORGE.Runner.AutomaticOne"}}</button>
                      <button type="button" data-action="skipParticipant" data-runtime-group-id="{{group.runtime.id}}" data-participant-id="{{participant.id}}">{{localize "PF2E_CHASE_FORGE.Runner.Skip"}}</button>
                    </div>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          {{else}}
            <div class="chase-runner-node"><strong>{{group.node.label}}</strong><span>{{group.node.type}}</span></div>
          {{/if}}


          {{#if group.hasOutgoingEdges}}
            <details class="chase-runner-route-admin">
              <summary><i class="fa-solid fa-screwdriver-wrench"></i> {{localize "PF2E_CHASE_FORGE.Runner.RouteAdmin"}}</summary>
              <div class="chase-runner-route-admin-list">
                {{#each group.outgoingEdges as |edge|}}
                  <div class="chase-runner-route-admin-row">
                    <span><strong>{{edge.label}}</strong> · {{edge.type}} · {{edge.visibility}}</span>
                    <span class="chase-runner-pill">{{#if edge.available}}{{localize "PF2E_CHASE_FORGE.Runner.RouteAvailable"}}{{else}}{{localize "PF2E_CHASE_FORGE.Runner.RouteUnavailable"}}{{/if}}</span>
                    <button type="button" data-action="unlockEdge" data-edge-id="{{edge.edgeId}}"><i class="fa-solid fa-lock-open"></i></button>
                    <button type="button" data-action="lockEdge" data-edge-id="{{edge.edgeId}}"><i class="fa-solid fa-lock"></i></button>
                  </div>
                {{/each}}
              </div>
            </details>
          {{/if}}

          {{#if group.routeChoiceAvailable}}
            <div class="chase-runner-route-choice">
              <strong>{{localize "PF2E_CHASE_FORGE.Runner.ChooseRoute"}}</strong>
              <div class="chase-runner-route-buttons">
                {{#each group.transitions as |route|}}<button type="button" data-action="chooseRoute" data-runtime-group-id="{{group.runtime.id}}" data-edge-id="{{route.edgeId}}"><i class="fa-solid fa-route"></i> {{route.label}}</button>{{/each}}
              </div>
            </div>
          {{/if}}
        </section>
      {{/each}}
    </div>
    </div>
  </div>
</div>
